# Base URL of the Express API (the same backend the web app uses).
#
#  - Android emulator  : http://10.0.2.2:5000/api   (10.0.2.2 is the emulator's alias for your computer)
#                        (http://localhost:5000/api is rewritten to 10.0.2.2 automatically on Android)
#  - Physical device   : http://<your-computer-LAN-IP>:5000/api   (phone and computer on the same Wi-Fi)
#  - Production        : https://api.yourdomain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
