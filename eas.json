{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.4.3",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://expense-tracker-backend-f5u3.onrender.com/api"
      }
    },
    "preview": {
      "bun": "1.4.3",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://expense-tracker-backend-f5u3.onrender.com/api"
      }
    },
    "production": {
      "bun": "1.4.3",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://expense-tracker-backend-f5u3.onrender.com/api"
      }
    }
  }
}
